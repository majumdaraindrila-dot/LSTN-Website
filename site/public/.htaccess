# ==========================================================================
#  LSTN website — Apache configuration (Blacknight / standard shared hosting)
# ==========================================================================

Options -Indexes
DirectoryIndex index.html

# --- Clean URLs: /about → /about/index.html (no redirect, no trailing slash)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS — uncomment ONLY after the SSL certificate is active on the domain
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Optional: force www (uncomment and adjust if desired)
  # RewriteCond %{HTTP_HOST} ^lifesciencestechnetwork\.com$ [NC]
  # RewriteRule ^ https://www.lifesciencestechnetwork.com%{REQUEST_URI} [L,R=301]

  # Remove trailing slash from page URLs (except the root)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteCond %{DOCUMENT_ROOT}%1/index.html -f
  RewriteRule ^ %1 [L,R=301]

  # Serve /page from /page/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>
DirectorySlash Off

ErrorDocument 404 /404.html

# --- Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml application/xml
</IfModule>

# --- Caching: hashed build assets forever, images 30 days, HTML always fresh
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^assets/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp

# --- Protect the contact-form config file
<Files "config.php">
  Require all denied
</Files>
